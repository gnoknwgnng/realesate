# Server Port
PORT=5000

# Neon Serverless PostgreSQL Database Connection
# From Neon Dashboard -> Dashboard -> Connection String -> "Pooled connection"
# Example: postgresql://neondb_owner:npg_xyz@ep-cold-shadow-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medproperties
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/medproperties

# Cloudflare R2 Storage (S3-Compatible Object Storage)
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=medproperties-media
# Optional custom domain or R2.dev public bucket URL
R2_PUBLIC_URL=https://pub-your_hash.r2.dev

